# Percept environment variables
# The current demo runs without these values.
# When connecting the production backend, NEVER expose server secrets in VITE_* variables.

# Supabase (future production integration)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — do not prefix with VITE_
OPENAI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
